  "$extensions": {
    "studio.atmo": {
      "typeRoles": [
        "label",
        "body-s",
        "body-m",
        "body-l",
        "body-xl",
        "subheading-s"
      ],
      "typeRolesRule": "Atlas crops the type range to six roles and never rescales them (decided 2026-09-28)",
      "labelWeightRule": "Label sets 11px metadata (tags, counts, hours, timestamps) at Regular, brand.font-weight.regular. The role's Medium is for emphasis only, such as status words like Open (D4, decided 2026-10-03)"
    }
