{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "version": "2025.10",
  "name": "Atmo design system",
  "description": "Brand in one mode; Intent per sub-brand (atmo, atlas, brand-os); Patterns per theme (light, dark), with component geometry in every theme.",
  "sets": {
    "brand": {
      "sources": [
        {
          "$ref": "brand.tokens.json"
        }
      ]
    },
    "components": {
      "sources": [
        {
          "$ref": "patterns/components.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "brand": {
      "description": "Sub-brand",
      "default": "atmo",
      "contexts": {
        "atmo": [
          {
            "$ref": "intent/atmo.tokens.json"
          }
        ],
        "atlas": [
          {
            "$ref": "intent/atlas.tokens.json"
          }
        ],
        "brand-os": [
          {
            "$ref": "intent/brand-os.tokens.json"
          }
        ]
      }
    },
    "theme": {
      "description": "Theme",
      "default": "light",
      "contexts": {
        "light": [
          {
            "$ref": "patterns/light.tokens.json"
          }
        ],
        "dark": [
          {
            "$ref": "patterns/dark.tokens.json"
          }
        ]
      }
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/brand"
    },
    {
      "$ref": "#/modifiers/brand"
    },
    {
      "$ref": "#/modifiers/theme"
    },
    {
      "$ref": "#/sets/components"
    }
  ]
}
